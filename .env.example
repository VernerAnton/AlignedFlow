# Firebase, for cloud sync. Copy to .env.local and fill in from the Firebase
# console (Project settings → your web app → SDK setup and configuration).
# Without these the app builds and runs perfectly well — it just runs
# local-only, and the sync panel says so.
#
# .env.local is gitignored and must stay that way. These values are not
# secrets in the usual sense (Vite bakes them into the public bundle, and
# Firebase is designed for that — the Firestore rule is what grants access),
# but there is no reason to commit them either.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firestore emulator instead of a real project.
# When set, the six values above are ignored (the emulator checks none of
# them) but must still be present. See docs/firebase-setup.md.
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
